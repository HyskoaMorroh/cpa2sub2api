# ====================================
# CPA2SUB2API 环境变量配置模板
# ====================================
#
# 使用说明：
# 1. 复制本文件为 .env: cp .env.example .env
# 2. 填写必填项（SUB2API_BASE_URL 和 SUB2API_ADMIN_KEY）
# 3. 根据需要调整可选项
# 4. 启动服务：docker compose up -d
#
# ====================================


# ====================================
# 必填配置
# ====================================

# sub2api 管理地址（必填）
# 示例：https://api.example.com
SUB2API_BASE_URL=

# sub2api 管理密钥（必填）
# 从 sub2api 配置中获取 admin_key
# 示例：admin-abc123def456...
SUB2API_ADMIN_KEY=


# ====================================
# CPA 配置（可选）
# ====================================

# CPA 地址（可选）
# 留空则从 config.yaml 的注释中提取
# 示例：https://cpa.example.com
CPA_BASE_URL=

# CPA 管理密钥（可选）
# 仅在线同步上游源码时使用
# 示例：your-cpa-management-key
CPA_MANAGEMENT_KEY=


# ====================================
# 代理配置（可选）
# ====================================

# 代理地址（可选）
# Docker Compose 模式默认：http://mihomo:7890
# 复用已有代理：http://host.docker.internal:7890
# 无代理：留空或删除本行
FALLBACK_PROXY=http://mihomo:7890


# ====================================
# 并发配置（可选）
# ====================================

# 导入并发数（默认 4，范围 1-8）
# 过高可能触发 sub2api 限流
IMPORT_WORKERS=4

# 测试计划生成并发数（默认 8）
# 用于批量创建定时探活计划
TEST_PLAN_WORKERS=8

# 定价推送并发数（默认 8）
# 用于批量推送模型定价
PRICING_WORKERS=8

# 默认账号并发数（默认 3）
# 每个账号的最大并发请求数
DEFAULT_CONCURRENCY=3

# 批量操作大小（默认 50）
# 批量创建/更新的每批数量
BATCH_SIZE=50


# ====================================
# 上游源码同步（可选）
# ====================================

# sub2api 源码路径（可选）
# 留空则从 GitHub 自动获取
# 本地路径示例：/path/to/sub2api
SUB2API_SRC=

# CPA 源码路径（可选）
# 留空则从 GitHub 自动获取
# 本地路径示例：/path/to/cpa
CPA_SRC=

# GitHub Token（可选）
# 仅在同步源码时超过 GitHub API 限制时需要
# 创建：https://github.com/settings/tokens
GITHUB_TOKEN=


# ====================================
# 功能开关（可选）
# ====================================

# 健康度重排（默认 true）
# 根据运行状态动态调整优先级
# 首次导入会自动关闭
HEALTH_RERANK_ENABLED=true

# 自动恢复（默认 true）
# 定时探活并自动恢复错误账号
AUTO_RECOVER_ENABLED=true

# 探活频率（默认每 30 分钟）
# Cron 表达式格式
AUTO_RECOVER_CRON=*/30 * * * *

# weight=0 处理策略（默认 true）
# true: 降优先级到 500+（不停用）
# false: 标记为 inactive（停用）
RESPECT_WEIGHT_ZERO=true

# 池模式（默认 true）
# 启用健康熔断器
POOL_MODE_ENABLED=true

# 同步已存在账号（默认 true）
# true: 更新已存在账号
# false: 只创建新账号
SYNC_EXISTING_ACCOUNTS=true


# ====================================
# 高级配置（谨慎修改）
# ====================================

# HTTP 超时（秒，默认 30）
HTTP_TIMEOUT=30

# HTTP 重试次数（默认 3）
HTTP_RETRIES=3

# User-Agent（可选）
# 用于绕过 Cloudflare 浏览器完整性检查
# 留空使用默认值
USER_AGENT=


# ====================================
# 调试配置（开发用）
# ====================================

# 日志级别（可选）
# 可选值：DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# 禁用代理兜底（可选）
# 调试代理问题时使用
# DISABLE_PROXY_FALLBACK=false


# ====================================
# 配置说明
# ====================================
#
# 1. 环境变量优先级高于 设置.json
# 2. Docker Compose 模式自动读取 .env
# 3. 布尔值使用 true/false（小写）
# 4. 数值类型直接填写数字（无引号）
# 5. 字符串类型无需引号（除非包含特殊字符）
# 6. 留空的配置使用默认值
#
# ====================================
