# CPA2SUB2API：公开配置模板。复制为 .env，勿提交真实 .env。
# VPS 使用部署根目录 /opt/deploy/.env；项目内部模板不应覆盖整栈配置。

# 镜像。Actions 的 Variables/Secrets 使用相同用户名与镜像名。
DOCKERHUB_USERNAME=
DOCKERHUB_IMAGE=cpa2sub2api
# 支持 latest 或 CI 产出的 sha-<完整提交SHA>，回滚时填已验证的旧标签。
CPA2SUB2API_IMAGE_TAG=latest

# 可选站级授权面板：docker compose --profile probe-ui up -d probe-ui
# 本机仅绑定127.0.0.1；生产使用SSH隧道或已明确Origin契约的反代。
# 用 secrets.token_urlsafe(48) 等方式生成随机令牌，只填私有.env，不提交。
PROBE_UI_TOKEN=
PROBE_UI_PORT=8775
PROBE_UI_ORIGIN=http://127.0.0.1:8775

# 可选请求转发：先启动request-relay（首次无状态时unready正常），
# 再import --preview核对，import --yes先导出并等就绪后才写管理端。
# 默认false保持原直连；相同state卷的独立来源必须使用不同稳定scope。
# true且relay已启用时，也迁移普通Direct受管账号以支持安全原生诊断。
REQUEST_RELAY_ENABLED=false
REQUEST_RELAY_FORCE_ALL_ACCOUNTS=false
REQUEST_RELAY_BASE_URL=http://request-relay:8380
REQUEST_RELAY_STATE_DIR=/app/state/relay
REQUEST_RELAY_SOURCE_SCOPE=default
REQUEST_RELAY_WEIGHTED_BUCKET=false
REQUEST_RELAY_TIMEOUT=600
# 最大解码响应量（1..512MiB）；默认64MiB。
REQUEST_RELAY_MAX_RESPONSE_BYTES=67108864
# 显式站级TLS预设JSON；空对象保持原TLS配置，禁止从布尔开关猜预设。
# 例：{"api.example.invalid":{"impersonate":"chrome136"}}
REQUEST_RELAY_TLS_PROFILES={}
# 启用上面的REQUEST_RELAY_ENABLED时同时启用：COMPOSE_PROFILES=request-relay
COMPOSE_PROFILES=

# sub2api 管理接口。容器间使用服务名，不使用 127.0.0.1。
SUB2API_BASE_URL=http://sub2api:8080
SUB2API_ADMIN_KEY=
# 真实 config.yaml 只读挂载时无需联网向 CPA 获取配置。
CPA_BASE_URL=
CPA_MANAGEMENT_KEY=

# 共享部署复用已有 mihomo；不创建第二套同名代理。
FALLBACK_PROXY=http://mihomo:7890
DISABLE_PROXY_FALLBACK=false
# 仅独立代理模式需要。订阅与 secret 留在私有 .env。
MIHOMO_SECRET=
MIHOMO_SUBSCRIPTIONS=
MIHOMO_SUB_WOG=
MIHOMO_SUB_WOGB=
# 关闭代理节点自动health/url-test；与模型上游探测开关分别控制。
# 共享栈由本项目mihomo-policy-init在原init之后落实此策略。
MIHOMO_AUTOMATIC_TESTS=false
# 仅共享叠加模板：填父compose已声明的卷key。独立模板使用mihomo-config。
MIHOMO_SHARED_VOLUME=mihomo-data
MIHOMO_BIND=127.0.0.1
MIHOMO_HTTP_PORT=7890
MIHOMO_API_PORT=9090

# 探活默认关闭。总闸与每站授权必须同时打开。
# 目录同步/配置修正不等于允许向上游发请求。
# 未保存总闸时的默认值；已保存master true/false优先。
MODEL_PROBE_ENABLED=false
# 独立硬禁：true阻断所有provider检测且拒绝开启新授权，允许关闭撤权。
MODEL_PROBE_HARD_DISABLED=false
# 空值使用持久化站授权；非空时仅这些域名可检测，逗号分隔。
# 禁探站始终拒绝检测，不能由环境变量或 CLI 覆盖。
ONLINE_PROBE_HOSTS=
MODEL_PROBE_WORKERS=2
# 结果缓存7天；自动任务另有每站共享604800秒周预算，缓存过期不授权请求。
MODEL_PROBE_CACHE_TTL=604800
AUTO_RECOVER_ENABLED=true
# 默认每周日 03:00；计划时区以 sub2api 的时区配置为准。
AUTO_RECOVER_CRON=0 3 * * 0
# 以下两项仍受总闸和站级授权控制，不会自行放行探活。
PROBE_INACTIVE=true
REVIVE_PROVEN_INACTIVE=true

# 配置同步策略。
SYNC_EXISTING_ACCOUNTS=true
PRUNE_STALE_ACCOUNTS=true
HEALTH_RERANK_ENABLED=true
RESPECT_WEIGHT_ZERO=true
POOL_MODE_ENABLED=true
IMPORT_WORKERS=4
TEST_PLAN_WORKERS=4
PRICING_WORKERS=4
DEFAULT_CONCURRENCY=3
BATCH_SIZE=50
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Docker 内将设置写入命名卷，删除/重建容器不丢失站级授权。
# 宿主机直接运行 Python 时可删除本行，或改为本机可写路径。
SETTINGS_PATH=/app/state/设置.json
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_TO_FILE=true
# 0=只同步一次，完成后退出0属于正常；勿配自动重启循环。
RUN_INTERVAL_SECONDS=0

# 离线源码目录可选。preview/显式offline检查不访问GitHub。
# 显式获取版本/源码用：python tool.py upstream refresh [--latest]
# upstream inspect / refresh --offline 不联网；字段漂移先处理再导入。
# 正常线上执行按TTL自动查询官方代码版本，与模型站探测分别控制。
FETCH_UPSTREAM_SRC=true
UPSTREAM_CACHE_TTL_SECONDS=604800
SUB2API_SRC=
CPA_SRC=
