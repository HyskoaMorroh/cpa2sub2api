# CPA 配置格式示例，全部域名和凭据均为不可用占位符。
# 应使用 CPA / CPA Manager 导出的真实 config.yaml，只读挂载到 /app/config.yaml。
# 不要把 sub2api 管理密钥、代理订阅或真实上游配置提交到 Git。
# 本文件不是完整 CPA 服务配置，也不会自行开启任何线上检测。
# 当前受管字段合同以官方 CPA v8.0.60 为基准；未知受管字段/类型漂移会拒绝消费和删除。
# 需要 cloak/rebuild/prompt-cache 等原 CPA 行为时，按 README 启用 request-relay。
# REQUEST_RELAY_SOURCE_SCOPE 默认 default；多来源分别使用稳定 scope 和独立 state_dir/卷。

claude-api-key:
  - api-key: REPLACE_WITH_PRIVATE_CLAUDE_KEY
    base-url: https://claude-upstream.example.invalid
    priority: 100
    weight: 1
    models:
      - name: claude-sonnet-4-5
        alias: claude-sonnet-4-5
    # 如上游确实要求固定头，请按其说明填写；无需则删除 headers。
    headers:
      X-Custom-Header: REPLACE_IF_REQUIRED
    # 可选工具扩展：仅在启用 request-relay 且目标确需该预设时取消注释。
    # 不是合法客户端身份/签名保证；TLS 证书与主机名验证仍然启用。
    # request-relay-tls:
    #   impersonate: chrome136
    #   ca-bundle: /app/certs/private-ca.pem  # 可选，须另行只读挂载真实CA；没有则删
    # 容器共享代理示例；无需代理时删除本行。
    proxy-url: http://mihomo:7890

openai-compatibility:
  - name: example-openai-provider
    base-url: https://openai-upstream.example.invalid/v1
    api-key-entries:
      - api-key: REPLACE_WITH_PRIVATE_OPENAI_KEY
    priority: 100
    weight: 1
    models:
      - name: example-chat-model
        alias: example-chat-model

codex-api-key:
  - api-key: REPLACE_WITH_PRIVATE_CODEX_KEY
    base-url: https://codex-upstream.example.invalid
    priority: 100
    weight: 1
    models:
      - name: example-code-model
        alias: example-code-model

gemini-api-key:
  - api-key: REPLACE_WITH_PRIVATE_GEMINI_KEY
    base-url: https://gemini-upstream.example.invalid
    priority: 100
    weight: 1
    models:
      - name: example-gemini-model
        alias: example-gemini-model
