# ====================================
# Docker 构建忽略文件
# ====================================

# ====================================
# 敏感信息
# ====================================
设置.json
config.yaml
.env
.env.*
!.env.example

# 密钥和凭证
*.key
*.pem
*.crt
*.cer
*.pfx

# ====================================
# 输出和缓存
# ====================================
out/
output/
*.log
*.mhtml

# 上游缓存
upstream-cache/

# 备份文件
*.bak
*~
*.swp
*.swo
*.backup
*-backup-*

# ====================================
# 开发文件
# ====================================
.git/
.gitignore
.github/
.vscode/
.idea/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ====================================
# 文档和说明
# ====================================
*.md
!DOCKER_DEPLOY.md
LICENSE
.editorconfig

# ====================================
# 测试文件
# ====================================
test_*.py
verify_*.py
check_*.py
debug_*.py
*_test.py
tests/
test/

# ====================================
# 临时文件
# ====================================
*.tmp
*.temp
tmp/
temp/

# ====================================
# 操作系统文件
# ====================================
.DS_Store
Thumbs.db
desktop.ini

# ====================================
# Docker 相关
# ====================================
Dockerfile
docker-compose*.yml
.dockerignore

# ====================================
# 批处理和脚本
# ====================================
# 注意：mihomo-manager/*.sh 是**必须进镜像**的（mihomo-init 容器拿它当
# entrypoint）。所以这里不能一刀切排除 *.sh，只能按具体文件排除。
*.bat
*.cmd
!entrypoint.sh

# ====================================
# Mihomo
# ====================================
# 只排除"运行时会生成/含私密值"的东西，模板与脚本必须进镜像：
# 部署方式是 VPS 只拉镜像，宿主不预置文件，配置由 mihomo-init
# 从 mihomo-manager/mihomo/config.template.yaml 物化出来。
mihomo-manager/mihomo/config.yaml
mihomo-manager/mihomo-subscriptions.conf
mihomo-manager/providers/

# ====================================
# 其他
# ====================================
说明书.html
pri.txt
model.txt
